   RCLCPP_INFO_EXPRESSION(get_logger(), headless_, "Running in HEADLESS mode.");
 
+  // WSLg exposes both Wayland and X11. GLFW prefers Wayland there, but its
+  // windows do not receive the normal WSLg title bar and borders. Select the
+  // XWayland backend before GLFW is initialized so the simulator is decorated.
+  if (!headless_ && std::getenv("WSL_DISTRO_NAME") != nullptr)
+  {
+    glfwInitHint(GLFW_PLATFORM, GLFW_PLATFORM_X11);
+    RCLCPP_INFO(get_logger(), "Running under WSL; using GLFW's X11 backend for window decorations.");
+  }
+
