-if(mujoco_SIMULATE)
+# ros2_control discovers this plugin through the ament resource registered
+# below. Copying it into an apt-owned mujoco_vendor prefix would require root
+# and makes ordinary overlay builds emit a permission error. Keep the optional
+# standalone `simulate` integration explicit instead.
+option(MUJOCO_3D_LIDAR_INSTALL_NEXT_TO_SIMULATE
+  "Also install the plugin beside the standalone MuJoCo simulate executable"
+  OFF)
+if(MUJOCO_3D_LIDAR_INSTALL_NEXT_TO_SIMULATE)
+  cmake_path(SET _mujoco_vendor_prefix NORMALIZE "${mujoco_vendor_DIR}/../../..")
+  find_program(mujoco_SIMULATE
+    NAMES simulate mujoco-simulate
+    HINTS "${_mujoco_vendor_prefix}/opt/mujoco_vendor/bin"
+          "${_mujoco_vendor_prefix}/lib/mujoco_vendor"
+    REQUIRED
+  )
   cmake_path(SET mujoco_BIN_PATH NORMALIZE ${mujoco_SIMULATE}/..)
-  install(CODE "
-    execute_process(
-      COMMAND cp -f \"\${CMAKE_INSTALL_PREFIX}/lib/${PROJECT_NAME}/mujoco_plugin/libmujoco_3d_lidar.so\"
-                    \"${mujoco_BIN_PATH}/mujoco_plugin/\"
-      RESULT_VARIABLE _err)
-    if(_err)
-      message(WARNING \"Could not install lidar plugin next to simulate! Manually copy it to ${mujoco_BIN_PATH}/mujoco_plugin/\")
-    endif()
-  ")
-else()
-  message(WARNING "NO SIMULATE FOUND!\n "
-    "To use the lidar plugin with simulate, you must manually copy libmujoco_3d_lidar.so "
-    "into the /mujoco_plugin/ next to the simulate application. Refer to the mujoco_extension "
-    "documentation for more information.")
+  install(FILES
+    "${CMAKE_CURRENT_BINARY_DIR}/libmujoco_3d_lidar.so"
+    DESTINATION "${mujoco_BIN_PATH}/mujoco_plugin"
+  )
 endif()
 
